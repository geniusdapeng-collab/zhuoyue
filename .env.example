# ============================================================
# Commercial Ad Skill Orchestrator — 环境配置模板
# 复制为 .env 并根据环境修改
# ============================================================

# ---- 应用版本 ----
VERSION=1.0.0

# ---- 运行环境：development | testing | production ----
NODE_ENV=production

# ---- 日志级别：debug | info | warn | error ----
LOG_LEVEL=info

# ---- EventBus HTTP 端口 ----
EVENT_BUS_PORT=3000

# ---- Pipeline 并发限制 ----
MAX_PIPELINE_CONCURRENCY=3

# ---- Skill 默认超时（毫秒）----
SKILL_TIMEOUT_MS=30000

# ---- Saga 补偿机制开关 ----
ENABLE_COMPENSATION=true

# ---- 指标收集开关 ----
ENABLE_METRICS=true

# ---- 指标保留时间（小时）----
METRICS_RETENTION_HOURS=24

# ---- Docker Compose 项目名 ----
COMPOSE_PROJECT_NAME=skill-orchestrator
